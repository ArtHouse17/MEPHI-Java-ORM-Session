            UPDATE course
            SET title = 'ORM-фреймворки для Java'
            WHERE title = 'ORM и Hibernate'
              AND teacher_id = (SELECT id FROM app_user WHERE email = 'teacher@example.test');
        </sql>
    </changeSet>
