@base = http://localhost:8080/api

### Получить ID преподавателя и студента
GET {{base}}/users

> {%
    const teacher = response.body.find(user => user.email === "teacher@example.test");
    const student = response.body.find(user => user.email === "student@example.test");
    client.global.set("teacherId", teacher.id);
    client.global.set("studentId", student.id);
%}

### Найти демонстрационный курс
GET {{base}}/courses

> {%
    const course = response.body.find(item => item.title === "ORM и Hibernate");
    client.global.set("courseId", course.id);
%}

### Открыть программу курса и найти урок
GET {{base}}/courses/{{courseId}}/curriculum

> {%
    client.global.set("moduleId", response.body.modules[0].module.id);
    client.global.set("lessonId", response.body.modules[0].lessons[0].id);
%}

### Посмотреть расписание курса
GET {{base}}/courses/{{courseId}}/schedule

### Посмотреть записи студентов
GET {{base}}/courses/{{courseId}}/enrollments

### Найти задание урока
GET {{base}}/assignments?lessonId={{lessonId}}

> {%
    const assignment = response.body.find(item => item.title === "Диагностика N+1");
    client.global.set("assignmentId", assignment.id);
%}

### Сдать решение
POST {{base}}/assignments/{{assignmentId}}/submissions
Content-Type: application/json
X-Actor-Id: {{studentId}}

{
  "content": "Получил N+1 при чтении уроков в цикле. Вынес чтение уроков в один запрос по ID курса."
}

> {%
    if (response.status === 201) {
        client.global.set("submissionId", response.body.id);
    }
%}

### Оценить решение
PUT {{base}}/assignments/{{assignmentId}}/submissions/{{submissionId}}/grade
Content-Type: application/json
X-Actor-Id: {{teacherId}}

{
  "score": 95,
  "feedback": "Хорошо. Приложите сравнение количества SQL-запросов."
}

### Прочитать оценённую работу
GET {{base}}/assignments/{{assignmentId}}/submissions/{{submissionId}}
X-Actor-Id: {{studentId}}

### Найти тест
GET {{base}}/quizzes?moduleId={{moduleId}}

> {%
    client.global.set("quizId", response.body[0].id);
%}

### Получить вопросы и варианты ответа
GET {{base}}/quizzes/{{quizId}}

> {%
    const question = response.body.questions[0];
    client.global.set("questionId", question.question.id);
    client.global.set("optionId", question.options[0].id);
%}

### Пройти тест
POST {{base}}/quizzes/{{quizId}}/attempts
Content-Type: application/json
X-Actor-Id: {{studentId}}

{
  "answers": [
    { "questionId": {{questionId}}, "optionId": {{optionId}} }
  ]
}

### Получить сохранённый результат
GET {{base}}/quizzes/{{quizId}}/result
X-Actor-Id: {{studentId}}
